    },
    {
      "name": "3. Validação (400)",
      "description": "Entradas inválidas. Todas devem responder 400 com application/problem+json, sem gravar nada.",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 400 Bad Request', () => pm.response.to.have.status(400));",
              "",
              "pm.test('Content-Type application/problem+json', () => {",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
              "});",
              "",
              "pm.test('detail orienta sobre descricao e nota', () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body.status).to.eql(400);",
              "    pm.expect(body.detail).to.include('descricao');",
              "    pm.expect(body.detail).to.include('nota');",
              "});"
            ]
          }
        }
      ],
